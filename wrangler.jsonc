{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simple-vet-clinic",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "simplevetclinic.win",
      "custom_domain": true
    },
    {
      "pattern": "www.simplevetclinic.win",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simple-vet-db",
      "database_id": "bee285ed-c9fa-45e9-979f-99abe64887a1",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "simple-vet-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
